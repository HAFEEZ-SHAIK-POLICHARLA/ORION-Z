{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "src/sih_detector/api.py"
        }
    },
    "routes": [
        {
            "src": "/api(/.*)?",
            "dest": "service:backend"
        },
        {
            "src": "/ws(/.*)?",
            "dest": "service:backend"
        },
        {
            "src": "/assets/(.*)",
            "dest": "service:frontend"
        },
        {
            "src": "/(.*\\.(?:png|jpg|jpeg|gif|svg|ico|js|css|json|woff|woff2|ttf|eot|map|txt|xml))",
            "dest": "service:frontend"
        },
        {
            "src": "/(.*)",
            "dest": "service:frontend/index.html"
        }
    ]
}