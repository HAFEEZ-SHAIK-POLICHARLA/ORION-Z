{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "src/sih_detector/api.py"
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/ws(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/assets/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        },
        {
            "source": "/(.*\\.(?:png|jpg|jpeg|gif|svg|ico|js|css|json|woff|woff2|ttf|eot|map|txt|xml))",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend",
                "path": "/index.html"
            }
        }
    ]
}